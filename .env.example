# Google Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# Required for /mcp/call/* and enforced on the web endpoints when set
APP_API_KEY=change_me_to_a_long_random_string

# Server binding (keep 127.0.0.1 unless behind authentication or a trusted network)
HOST=127.0.0.1
PORT=8000

# Per-run limits for R
R_TIMEOUT_SECONDS=30
R_MAX_MEMORY_MB=2048
R_MAX_FILE_MB=100
